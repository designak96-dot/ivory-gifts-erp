APP_NAME="Ivory Gifts ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://accounts.ivorygifts.ae
APP_TIMEZONE=Asia/Dubai

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
